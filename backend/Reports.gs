function report_(filters){
 const tanks=tanks_(),ledger=rows_('MOVIMENTOS'),costs=costed_(tanks,ledger);const rows=filter_(costs,filters),history=filter_(ledger,Object.assign({},filters,{recorded:true}));
 const sum=(list,fn)=>list.reduce((s,m)=>s+fn(m),0);const outs=rows.filter(m=>m.kind==='SAIDA'),ins=rows.filter(m=>m.kind==='ENTRADA');
 const groups=(key)=>{const g={};outs.forEach(m=>{const k=m[key]||'—';const o=g[k]||(g[k]={name:k,litres:0,count:0,cost:0,incomplete:false});o.litres-=m.delta/1000;o.count++;if(m.cost==null)o.incomplete=true;else o.cost=roundMoney_(o.cost+m.cost);});return Object.values(g).sort((a,b)=>b.litres-a.litres);};
 const buckets={};rows.forEach(m=>{const k=(m.deliveryDate||dateKey_(m.at)).slice(0,7);const b=buckets[k]||(buckets[k]={month:k,out:0,in:0,cost:0,purchase:0,incomplete:false});if(m.kind==='SAIDA'){b.out-=m.delta/1000;if(m.cost==null)b.incomplete=true;else b.cost=roundMoney_(b.cost+m.cost);}if(m.kind==='ENTRADA'){b.in+=m.delta/1000;b.purchase=roundMoney_(b.purchase+(m.cost||0));}});
 const byDay={};outs.forEach(m=>{const k=dateKey_(m.at);byDay[k]=(byDay[k]||0)-m.delta/1000;});
 const stock=tanks.filter(t=>!filters?.tankId||filters.tankId===t.id).map(t=>{const selected=history.filter(m=>m.tankId===t.id);const start=filters?.start;const opening=t.initialMl+sum(ledger.filter(m=>m.tankId===t.id&&start&&dateKey_(m.at)<start),m=>m.delta);return {id:t.id,name:t.name,opening:opening/1000,in:sum(selected.filter(m=>m.kind==='ENTRADA'),m=>m.delta)/1000,out:-sum(selected.filter(m=>m.kind==='SAIDA'),m=>m.delta)/1000,adjustment:sum(selected.filter(m=>!['ENTRADA','SAIDA'].includes(m.kind)),m=>m.delta)/1000,closing:(opening+sum(selected,m=>m.delta))/1000};});
 const years={};outs.forEach(m=>{const y=dateKey_(m.at).slice(0,4);years[y]=(years[y]||0)-m.delta/1000;});
 let comparison=null;if(filters&&filters.start&&filters.end){const from=new Date(filters.start+'T12:00:00Z'),to=new Date(filters.end+'T12:00:00Z'),span=Math.round((to-from)/86400000)+1;const priorStart=dateKey_(new Date(+from-span*86400000)),priorEnd=dateKey_(new Date(+from-86400000));const prior=filter_(costs,Object.assign({},filters,{start:priorStart,end:priorEnd})).filter(m=>m.kind==='SAIDA');const priorLitres=-sum(prior,m=>m.delta)/1000;comparison={start:priorStart,end:priorEnd,litres:priorLitres,changePercent:priorLitres?((-sum(outs,m=>m.delta)/1000/priorLitres-1)*100):null};}
 const totalCost=outs.some(m=>m.cost==null)?null:roundMoney_(sum(outs,m=>m.cost||0));
 return {title:'COMBUSTÍVEL 360 · Monte do Pasto',issuedAt:new Date().toISOString(),filters:filters||{},years:Object.entries(years).map(([year,litres])=>({year,litres})),comparison,summary:{litres:-sum(outs,m=>m.delta)/1000,count:outs.length,received:sum(ins,m=>m.delta)/1000,purchase:roundMoney_(sum(ins,m=>m.cost||0)),consumptionCost:totalCost},rows,history,stock,vehicles:groups('plate'),users:groups('userName'),tanks:groups('tankName'),months:Object.values(buckets).sort((a,b)=>a.month.localeCompare(b.month)),days:Object.entries(byDay).map(([day,litres])=>({day,litres})).sort((a,b)=>a.day.localeCompare(b.day))};
}
function overview_(filters){const tanks=tanks_(),ledger=rows_('MOVIMENTOS'),records=costed_(tanks,ledger),config=config_(),now=new Date();const forecasts=tanks.map(t=>forecast_(t,records,config,now));const report=report_(filters);const today=dateKey_(now),month=today.slice(0,7);const monthly=records.filter(m=>dateKey_(m.at).startsWith(month));return {tanks,forecasts,anomalies:anomalies_(records),report,catalog:{users:rows_('UTILIZADORES').map(publicUser_),vehicles:rows_('VEICULOS'),tanks:rows_('DEPOSITOS').map(t=>({id:t.id,name:t.name}))},kpi:{stock:tanks.reduce((s,t)=>s+t.stockMl/1000,0),today:records.filter(m=>m.kind==='SAIDA'&&dateKey_(m.at)===today).reduce((s,m)=>s-m.delta/1000,0),month:monthly.filter(m=>m.kind==='SAIDA').reduce((s,m)=>s-m.delta/1000,0),received:monthly.filter(m=>m.kind==='ENTRADA').reduce((s,m)=>s+m.delta/1000,0),cost:monthly.some(m=>m.kind==='SAIDA'&&m.cost==null)?null:roundMoney_(monthly.filter(m=>m.kind==='SAIDA').reduce((s,m)=>s+(m.cost||0),0)),alerts:forecasts.filter(f=>f.state!=='NORMAL').length}};}
function escape_(s){return String(s==null?'—':s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));}
function reportTable_(r){const header=['Data','Tipo','Depósito','Matrícula','Utilizador','Litros com sinal','Custo EUR'];return [header].concat(r.rows.map(m=>[m.deliveryDate||dateKey_(m.at),m.kind,m.tankName,m.plate||'',m.userName,m.delta/1000,m.cost==null?'Incompleto':m.cost]));}
function reportHtml_(r,extra){const s=r.summary;return '<!doctype html><html lang="pt-PT"><head><meta charset="utf-8"><style>body{font:11px Arial;color:#17251e;margin:28px}h1{font-size:25px;border-bottom:4px solid #2b8159;padding-bottom:12px}h2{margin-top:26px}table{border-collapse:collapse;width:100%;font-size:9px}td,th{border-bottom:1px solid #ddd;padding:7px;text-align:left}th{background:#e8f1ea}p{line-height:1.5}</style></head><body><h1>COMBUSTÍVEL 360</h1><p>Monte do Pasto · Relatório de combustível<br>Período: '+escape_(r.filters.start||'Início')+' a '+escape_(r.filters.end||'Hoje')+'<br>Emitido: '+escape_(Utilities.formatDate(new Date(r.issuedAt),'Europe/Lisbon','dd/MM/yyyy HH:mm'))+' · Filtros: '+escape_(JSON.stringify(r.filters))+'</p><h2>Resumo executivo</h2><p>Consumo: '+s.litres.toFixed(3)+' L · '+s.count+' abastecimentos<br>Entradas: '+s.received.toFixed(3)+' L · Aquisição: '+s.purchase.toFixed(2)+' €<br>Custo estimado de consumo: '+(s.consumptionCost==null?'Incompleto — custo inicial desconhecido':s.consumptionCost.toFixed(2)+' €')+'</p>'+['stock','vehicles','users','months','years'].map(key=>'<h2>'+({stock:'Balanço por depósito',vehicles:'Consumo por matrícula',users:'Registos por colaborador',months:'Evolução mensal',years:'Consumo anual'})[key]+'</h2>'+objectTable_(r[key])).join('')+(r.comparison?'<h2>Comparação com período anterior</h2><p>'+escape_(r.comparison.start+' a '+r.comparison.end+': '+r.comparison.litres+' L; variação '+(r.comparison.changePercent==null?'sem base':r.comparison.changePercent.toFixed(1)+'%'))+'</p>':'')+(extra||'')+'<h2>Movimentos efetivos (valores corrigidos)</h2><table>'+reportTable_(r).map((line,i)=>'<tr>'+line.map(c=>'<'+(i?'td':'th')+'>'+escape_(c)+'</'+(i?'td':'th')+'>').join('')+'</tr>').join('')+'</table><h2>Histórico conservado e acertos</h2>'+objectTable_(r.history.map(m=>({data:dateKey_(m.at),tipo:m.kind,deposito:m.tankName,litros:m.delta/1000,motivo:m.reason||'',referencia:m.root||m.id})))+'<p>Custos médios ponderados por depósito. As correções reexpressam o histórico; os movimentos originais continuam conservados. Os balanços completos por depósito requerem ausência de filtros por matrícula, tipo e utilizador.</p></body></html>';}
function pdfBlob_(r,extra){return Utilities.newBlob(reportHtml_(r,extra),'text/html','relatorio.html').getAs('application/pdf').setName('combustivel-360.pdf');}
function export_(filters,format){const r=report_(filters);assert_(['pdf','xlsx'].includes(format),'Formato inválido.');let blob;
 if(format==='pdf')blob=pdfBlob_(r);
 else {const temp=SpreadsheetApp.create('COMBUSTÍVEL 360 — exportação');try{const sh=temp.getSheets()[0];sh.setName('Relatório');const data=[[r.title],['Período',r.filters.start||'Início',r.filters.end||'Hoje'],['Emissão',r.issuedAt],['Filtros',JSON.stringify(r.filters)],['Consumo L',r.summary.litres],['Aquisição EUR',r.summary.purchase],['Custo consumo EUR',r.summary.consumptionCost==null?'Incompleto':r.summary.consumptionCost],[],...reportTable_(r)];const width=Math.max(...data.map(x=>x.length));sh.getRange(1,1,data.length,width).setValues(data.map(row=>Array.from({length:width},(_,i)=>safeCell_(row[i]??''))));sh.getRange(1,1,1,width).setFontWeight('bold');['stock','vehicles','users','months','years'].forEach(key=>{const list=r[key];if(!list.length)return;const tab=temp.insertSheet(key),keys=Object.keys(list[0]);tab.getRange(1,1,list.length+1,keys.length).setValues([keys,...list.map(o=>keys.map(k=>safeCell_(o[k]??'')))]);});const hist=temp.insertSheet('Histórico');const history=[['Data','Tipo','Depósito','Matrícula','Utilizador','Litros','Stock anterior','Stock posterior','Motivo','Original'],...r.history.map(m=>[m.at,m.kind,m.tankName,m.plate||'',m.userName,m.delta/1000,m.before/1000,m.after/1000,m.reason||'',m.root||m.id])];hist.getRange(1,1,history.length,10).setValues(history.map(row=>row.map(safeCell_)));SpreadsheetApp.flush();const response=UrlFetchApp.fetch('https://docs.google.com/spreadsheets/d/'+temp.getId()+'/export?format=xlsx',{headers:{Authorization:'Bearer '+ScriptApp.getOAuthToken()},muteHttpExceptions:true});assert_(response.getResponseCode()===200,'Exportação indisponível. Tente novamente.');blob=response.getBlob().setName('combustivel-360.xlsx');}finally{DriveApp.getFileById(temp.getId()).setTrashed(true);}}
 return {name:blob.getName(),mime:format==='pdf'?'application/pdf':'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet',base64:Utilities.base64Encode(blob.getBytes())};}

function objectTable_(rows){if(!rows.length)return '<p>Sem registos.</p>';const labels={name:'Identificação',litres:'Litros',count:'Registos',cost:'Custo EUR',incomplete:'Custo incompleto',opening:'Inicial L',in:'Entradas L',out:'Saídas L',adjustment:'Acertos/correções L',closing:'Final L',month:'Mês',year:'Ano',purchase:'Aquisição EUR'};const keys=Object.keys(rows[0]).filter(k=>k!=='id');return '<table><tr>'+keys.map(k=>'<th>'+escape_(labels[k]||k)+'</th>').join('')+'</tr>'+rows.map(o=>'<tr>'+keys.map(k=>'<td>'+escape_(typeof o[k]==='number'?(['cost','purchase'].includes(k)?roundMoney_(o[k]):Math.round(o[k]*1000)/1000):typeof o[k]==='boolean'?(o[k]?'Sim':'Não'):o[k])+'</td>').join('')+'</tr>').join('')+'</table>';}
