function sendOnce_(id,build){
 const old=rows_('ALERTAS').find(x=>x.id===id);if(old&&['ENVIADO','A_ENVIAR','INCERTO'].includes(old.status))return false;
 const email=build();if(!email)return false;const row=Object.assign({id,at:new Date().toISOString(),status:'A_ENVIAR'},email.record);
 /* Persist reservation before sending: an ambiguous interruption is reviewed manually, never auto-retried. */
 put_('ALERTAS',row);SpreadsheetApp.flush();try{MailApp.sendEmail(email.message);row.status='ENVIADO';row.sentAt=new Date().toISOString();put_('ALERTAS',row);return true;}catch(err){row.status='INCERTO';put_('ALERTAS',row);throw err;}
}
function verificarAlertas_(){return lock_(()=>{const config=config_();if(!config.alerts||!config.emails.length)return;const tanks=tanks_(),records=costed_(tanks,rows_('MOVIMENTOS'));tanks.filter(t=>t.active).forEach(t=>{const f=forecast_(t,records,config,new Date());const id='previsao:'+t.id+':'+dateKey_(new Date());put_('PREVISOES',Object.assign({},f,{id,at:new Date().toISOString()}));
 const open=rows_('ALERTAS').filter(a=>a.tankId===t.id&&a.kind!=='MENSAL'&&a.status!=='RESOLVIDO');if(f.state==='NORMAL'){open.forEach(a=>{a.status='RESOLVIDO';put_('ALERTAS',a);});return;}
 if(open.some(a=>a.kind===f.state&&['ENVIADO','A_ENVIAR','INCERTO'].includes(a.status)))return;
 const description=`${t.name}: ${(t.stockMl/1000).toFixed(1)} L; mínimo ${(t.minimumMl/1000).toFixed(1)} L; consumo estimado ${f.daily} L/dia; autonomia ${f.autonomy==null?'indisponível':f.autonomy.toFixed(1)+' dias'}. Encomendar até ${f.orderDate||'data indeterminada'}; recomendação ${f.quantity} L. Confiança: ${f.confidence}. ${f.note}`;
 sendOnce_('alerta:'+t.id+':'+f.state+':'+Date.now(),()=>({record:{kind:f.state,tankId:t.id,description},message:{to:config.emails.join(','),subject:'COMBUSTÍVEL 360 · '+f.state+' · '+t.name,body:'Monte do Pasto\n'+description,htmlBody:'<h1>COMBUSTÍVEL 360</h1><p>Monte do Pasto</p><p>'+escape_(description)+'</p>'}}));});});}
function relatorioMensal_(){return lock_(()=>{const config=config_();if(!config.emails.length)return;const today=dateKey_(new Date());const end=new Date(today.slice(0,7)+'-01T12:00:00Z');end.setUTCDate(0);const endKey=dateKey_(end),start=endKey.slice(0,7)+'-01';sendOnce_('mensal:'+start.slice(0,7),()=>{
 const r=report_({start,end:endKey});const beforeEnd=new Date(start+'T12:00:00Z');beforeEnd.setUTCDate(0);const prev=report_({start:dateKey_(beforeEnd).slice(0,7)+'-01',end:dateKey_(beforeEnd)});const evolution=prev.summary.litres?((r.summary.litres/prev.summary.litres-1)*100).toFixed(1)+'%':'Sem base de comparação';const forecasts=tanks_().filter(t=>t.active).map(t=>forecast_(t,costed_(tanks_(),rows_('MOVIMENTOS')),config,new Date()));const relevant=rows_('ALERTAS').filter(a=>a.at&&dateKey_(a.at)>=start&&dateKey_(a.at)<=endKey);const extra='<h2>Análise e planeamento</h2><p>Evolução face ao mês anterior: '+escape_(evolution)+'</p>'+forecasts.map(f=>'<p>'+escape_(f.tankId+': '+f.note+' Encomenda recomendada: '+f.orderDate+'. Quantidade: '+f.quantity+' L. Projeção indicativa para 30 dias: '+(f.daily*30).toFixed(1)+' L. Confiança: '+f.confidence)+'</p>').join('')+'<h2>Alertas do período</h2><p>'+escape_(relevant.map(a=>a.description).join('\n')||'Sem alertas registados.')+'</p><h2>Acertos</h2><p>'+objectTable_(r.history.filter(m=>m.kind==='ACERTO').map(m=>({data:dateKey_(m.at),deposito:m.tankName,anterior:m.before/1000,medido:m.measuredMl/1000,diferenca:m.delta/1000,motivo:m.reason})))+'</p>';
 return {record:{kind:'MENSAL',description:'Relatório '+start.slice(0,7)},message:{to:config.emails.join(','),subject:'COMBUSTÍVEL 360 · Relatório mensal · '+start.slice(0,7),body:'Monte do Pasto — relatório mensal em anexo.',htmlBody:reportHtml_(r,extra),attachments:[pdfBlob_(r,extra)]}};});});}
